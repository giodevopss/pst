# Copie este ficheiro para ".env.local" no seu computador (`cp .env.example .env.local`).
# O Next carrega .env.local automaticamente em dev. Não commite .env.local.

# Meta (Facebook) Ads — Pixel no browser + Conversions API (CAPI) no servidor
# ID do Pixel (Events Manager). Obrigatório no Railway ANTES do build (Dockerfile repassa no `next build`).
# Se omitir no deploy, o código usa o default 2545916985811236 em src/lib/meta-pixel.ts.
NEXT_PUBLIC_META_PIXEL_ID=2545916985811236
META_ACCESS_TOKEN=
# Opcional: desliga o envio CAPI (mantém só o Pixel no browser)
# META_CAPI_DISABLED=1

# URLs públicas (defina no Railway nas variáveis do serviço — disponíveis no build)
NEXT_PUBLIC_SITE_URL=https://seu-app.up.railway.app
# Opcional — URL absoluta ou caminho sob /public (ex.: /models/album-copa-2026.glb)
NEXT_PUBLIC_HERO_MODEL_URL=

# MongoDB — URI (local/dev). No Railway, o plugin costuma injectar só MONGO_URL no serviço da app —
# o código aceita MONGODB_URI ou MONGO_URL (nesta ordem).
MONGODB_URI=mongodb://localhost:27017
# MONGO_URL=
MONGODB_DB=copa2026

# Remarketing — abandono no checkout gravado na coleção `checkout_abandonos` (upsert por sessão na aba).
# Defina REMARKETING_CHECKOUT_ABANDON=0 para desligar o endpoint `/api/remarketing/checkout-abandon`.
# REMARKETING_CHECKOUT_ABANDON=0

# Painel admin (/admin/pedidos) — ver pedidos no banco (obrigatório em produção; sem fallback)
ADMIN_PASSWORD=troque-esta-senha
ADMIN_PANEL_SECRET=use-uma-string-longa-aleatoria-min-32-chars
# Só se a app em produção for servida só em HTTP sem TLS (raríssimo): ADMIN_COOKIE_INSECURE=1

# Sessão de usuário (/conta) — segredo para assinar o cookie de sessão do cliente
USER_SESSION_SECRET=dev-user-secret-copa2026

# Stripe — PIX (Brasil). Chave secreta só no servidor; publishable no cliente habilita PIX via Stripe.
# Dashboard → Developers → Webhooks: URL https://SEU_DOMINIO/api/stripe/webhook (eventos payment_intent.*)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Mercado Pago — PIX (Brasil). Com MERCADOPAGO_ACCESS_TOKEN no servidor, o checkout usa PIX MP por defeito
# (consulta /api/mercadopago/pix-status). Se Stripe também estiver configurado, omitir NEXT_PUBLIC_PIX_PROVIDER
# = preferência MP; use NEXT_PUBLIC_PIX_PROVIDER=stripe para forçar Stripe.
MERCADOPAGO_ACCESS_TOKEN=
# NEXT_PUBLIC_PIX_PROVIDER=stripe

# Só demo: permite POST /api/fintech em NODE_ENV=production (simula cartão; grava dados sensíveis — evite em site real).
# FINTECH_ALLOW_PRODUCTION=1